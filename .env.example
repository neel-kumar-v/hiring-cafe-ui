# Cloud Convex (hiring-cafe-ui)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Dev-only (read by next.config.ts): comma-separated extra hosts allowed to load
# Next dev resources — JS chunks, RSC payload, HMR socket. Needed when browsing
# the dev server over Tailscale/MagicDNS or a LAN hostname, otherwise those
# requests are rejected with 403 and the app never hydrates. Wildcards work.
ALLOWED_DEV_ORIGINS=
